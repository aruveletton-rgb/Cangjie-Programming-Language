# Provider and runtime environment template
#
# Copy to provider.env and fill in. Never commit the filled file.
# The API key is set by the account holder; the agent does not need to see it.
#
# Verify with: node src/backend/deploy/preflight-provider.mjs
# Add --live only after ICT_PROVIDER_REAL=1 has been set by the person who is
# authorised to declare that real provider calls are allowed.

# --- model provider (option A: Huawei Cloud MaaS, OpenAI-compatible) ---
# Base URL ends at /v1. Do not append /chat/completions.
ICT_PROVIDER_ENDPOINT=https://api.modelarts-maas.com/v1
ICT_PROVIDER_MODEL=
ICT_PROVIDER_API_KEY=
ICT_PROVIDER_NAME=huaweicloud-maas
ICT_PROVIDER_TIMEOUT_MS=30000
# Leave unset (or 0) until real calls are authorised. "1" means "I declare this is an
# authorised real provider" and is what makes realG1Ran true in responses.
ICT_PROVIDER_REAL=

# --- backend runtime ---
ICT_PORT=38082
ICT_DATA=src/data/synthetic.runtime.json
ICT_STORE=temp/backend/cloud/store.json
ICT_CONFIRM_TTL=300
# Loopback origins are always allowed. Set ICT_PUBLIC_ORIGIN to name exactly one
# public HTTPS origin (no wildcard, no path); it is appended to the allowlist and
# forces ICT_AUTH_MODE=session. Asking for demo mode together with a public origin
# is a startup error by design (main.cj:37-39).
ICT_CORS=http://127.0.0.1:5173,http://localhost:5173
ICT_PUBLIC_ORIGIN=
# Leave empty to derive from ICT_PUBLIC_ORIGIN (empty -> demo, set -> session).
ICT_AUTH_MODE=
ICT_SESSION_TTL=3600
ICT_LOGIN_MAX_FAILURES=10

# --- TLS reverse proxy (src/backend/deploy/tls-proxy.mjs) ---
TLS_BIND=0.0.0.0
TLS_PORT=8443
TLS_CERT=temp/backend/tls/tls.crt
TLS_KEY=temp/backend/tls/tls.key
UPSTREAM=http://127.0.0.1:38082
